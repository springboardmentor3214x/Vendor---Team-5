# Local Docker development defaults. Copy to .env only if you need overrides.
POSTGRES_DB=vendor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=4200
SECRET_KEY=change_this_for_local_docker_only
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_MINUTES=60
