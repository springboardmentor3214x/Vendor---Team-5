# Copy this file to .env before starting Docker. Replace the placeholder
# credentials with unique values. The real .env file is ignored by Git and
# must never be committed.
POSTGRES_DB=vendor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
FRONTEND_PORT=4200
SECRET_KEY=replace-with-a-long-random-secret

# Public Angular URL used in password-reset links.
FRONTEND_URL=http://localhost:4200

# Optional Gmail SMTP for password-reset emails. Use a Google App Password,
# never your normal Gmail password, and keep the real values only in .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-demo-gmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-demo-gmail@gmail.com

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_MINUTES=60
