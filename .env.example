# Copy this file to .env before starting Docker.  Replace POSTGRES_PASSWORD
# and SECRET_KEY with unique values before any EC2 deployment; .env is ignored
# by Git and must never be committed.
POSTGRES_DB=vendor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_database_password
FRONTEND_PORT=4200
SECRET_KEY=change_this_to_a_long_random_secret
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_MINUTES=60
