@baseUrl = http://localhost:8000

### Register Admin
# Use the real backend route only.
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Admin User Test",
  "email": "pranjali.admin2@example.com",
  "password": "Password123",
  "confirmPassword": "Password123",
  "role": "Administrator"
}

### Login Admin
# Expected: 200 with access_token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "pranjali.admin2@example.com",
  "password": "Password123"
}

### Get Current User
# Requires valid Bearer token from /auth/login
GET {{baseUrl}}/auth/me
Authorization: Bearer {{adminToken}}

### Note
# No real role-restricted route is currently available in the backend route layer
# using require_roles(...). Therefore, no live 403 role-check endpoint can be
# validated here against the current implemented FastAPI routes.
